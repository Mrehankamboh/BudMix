{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BudsLink",
  "version": "0.1.2",
  "identifier": "io.github.mrehankamboh.budslink",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "BudsLink contributors",
    "copyright": "Copyright (c) 2026 BudsLink contributors and Muhammad Shakaib Arsalan (BudsBridge)",
    "shortDescription": "Hear your laptop and your phone in the same Bluetooth buds",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
